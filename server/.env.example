# ==========================================
# ExpiryMate Backend Environment Variables
# ==========================================

# Port for the Express server to listen on
PORT=5000

# MongoDB Connection String (defaults to local MongoDB)
MONGODB_URI=mongodb://localhost:27017/expirymate

# Secret key used to sign and verify JSON Web Tokens (JWT)
JWT_SECRET=supersecret_jwt_key_change_in_production_12345

# Allowed Client Origin for CORS and cookie sharing
CLIENT_URL=http://localhost:5173

# Optional: Cloudinary credentials for receipt uploads
# If left empty, receipts are saved locally to /uploads during development
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: Nodemailer SMTP configuration for email reminders
# Example for Gmail: EMAIL_USER=your_email@gmail.com, EMAIL_PASSWORD=your_app_password
# If left empty, reminders log to console in dev mode without failing
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="ExpiryMate Reminders" <no-reply@expirymate.local>
