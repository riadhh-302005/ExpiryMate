# ==========================================
# ExpiryMate - Root .gitignore
# ==========================================

# Dependencies
node_modules/
*/node_modules/

# Environment Variables (Keep secrets private!)
.env
.env.local
.env.*.local
*.env
*/.env
!*.env.example

# Production builds
dist/
dist-ssr/
build/
client/dist/

# Local uploaded files (keep the folder via .gitkeep)
server/uploads/*
!server/uploads/.gitkeep

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor and OS files
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
